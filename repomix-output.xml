              entityType: 'TRANSACTION',
              entityId: tx.id,
              reason: payoutNote.trim() || `Remise au rang #${client.payoutRank} au lieu du rang attendu #${expectedNextRank}`,
            });
          }

          triggerSuccessFeedback();
          Alert.alert(
