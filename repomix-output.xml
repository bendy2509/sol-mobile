});
assert(limMid.remainingHands === 3 && limMid.remainingAmount === 7500 && !limMid.isCycleCompleted, 'Mid-cycle limits: 9 paid -> 3 remaining hands (7,500 HTG)');

const limFull = calculateCycleContributionLimits({
  currentPaidHands: 12,
  totalSlots: 12,
