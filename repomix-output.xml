});
assert(limInit.maxPotAmount === 30000 && limInit.remainingHands === 12 && !limInit.isCycleCompleted, 'Initial limits: 12 remaining hands (30,000 HTG) and not completed');

const limMid = calculateCycleContributionLimits({
  currentPaidHands: 9,
